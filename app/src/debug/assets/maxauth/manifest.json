{
  "manifest_version": 2,
  "name": "freemax-auth",
  "version": "1.0",
  "description": "Reads MAX web auth token for FreeMAX login",
  "browser_specific_settings": {
    "gecko": {
      "id": "maxauth@freemax.local"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web.max.ru/*"],
      "js": ["auth.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
